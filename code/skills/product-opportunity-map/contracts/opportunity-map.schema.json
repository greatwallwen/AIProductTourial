{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Traceable product opportunity map",
  "type": "object",
  "required": ["schema_version", "status", "source", "business_rules", "source_records", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "complete"},
    "source": {"type": "object"},
    "business_rules": {"type": "array"},
    "source_records": {"type": "array"},
    "nodes": {"type": "array", "minItems": 5},
    "edges": {"type": "array", "minItems": 5}
  },
  "additionalProperties": false
}
