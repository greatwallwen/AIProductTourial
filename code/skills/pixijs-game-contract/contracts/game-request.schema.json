{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chinese PixiJS mini-game request",
  "type": "object",
  "required": ["id", "title", "description", "duration_seconds", "score_per_ticket", "controls", "source", "tickets", "hazards", "health_boundary"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "integer", "minimum": 10, "maximum": 300},
    "score_per_ticket": {"type": "integer", "minimum": 1, "maximum": 100},
    "controls": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "source": {"type": "object"},
    "tickets": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "hazards": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "health_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
